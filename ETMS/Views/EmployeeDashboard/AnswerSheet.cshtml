@model IEnumerable<ETMS.Models.UserResponse>

@{
    ViewData["Title"] = "Answer Sheet";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Answer Sheet - @ViewBag.TestType</h2>

    <div class="table-responsive">
        <table class="table table-bordered table-striped text-center">
            <thead class="table-dark">
                <tr>
                    <th>No</th>
                    <th class="text-start">Question</th>
                    <th>Your Answer</th>
                    <th>Correct Answer</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var questionNumber = 1;
                }
                @foreach (var response in Model)
                {
                    var isCorrect = response.SelectedOption == response.Question.CorrectAnswer;
                    <tr>
                        <td><strong>@questionNumber</strong></td>
                        <td class="text-start">@response.Question.QuestionText</td>
                        <td>@response.SelectedOption</td>
                        <td>@response.Question.CorrectAnswer</td>
                        <td>
                            <span class="badge @(isCorrect ? "bg-success" : "bg-danger")">
                                @(isCorrect ? "✅ Correct" : "❌ Incorrect")
                            </span>
                        </td>
                    </tr>
                    questionNumber++;
                }
            </tbody>
        </table>
    </div>

    <div class="text-center mt-4">
        <a href="@Url.Action("TestResults", "EmployeeDashboard")" class="btn btn-primary">
            Back to Test Results
        </a>
    </div>
</div>


