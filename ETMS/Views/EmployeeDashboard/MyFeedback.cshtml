@model List<ETMS.Models.EmployeeReport>

@{
    ViewData["Title"] = "My Feedback";
}

<head>
    <title>@ViewData["Title"] - Employee Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* General Styles */
        body {
            color: black;
            font-family: 'Arial', sans-serif;
        }

        /* Sidebar */
        .sidebar {
            height: 100vh;
            width: 260px;
            position: fixed;
            background: linear-gradient(to bottom, #0d253f, #101820);
            padding-top: 20px;
            transition: all 0.3s ease-in-out;
        }

            .sidebar.collapsed {
                width: 80px;
            }

            .sidebar .nav-link {
                color: #ffffff;
                font-size: 16px;
                padding: 12px 20px;
                display: flex;
                align-items: center;
                transition: all 0.3s ease;
            }

                .sidebar .nav-link i {
                    min-width: 45px;
                    text-align: center;
                    transition: color 0.3s;
                }

                .sidebar .nav-link.active {
                    background-color: #172a45;
                    font-weight: bold;
                    border-left: 0px solid #00aaff;
                }

                    .sidebar .nav-link.active i {
                        color: #00aaff;
                    }

            .sidebar.collapsed .nav-link {
                justify-content: center;
                padding-left: 0;
            }

                .sidebar.collapsed .nav-link span {
                    display: none;
                }

        /* Navbar */
        .navbar {
            background: #172a45;
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 4px 6px rgba(0, 170, 255, 0.2);
        }

        .navbar-brand, .navbar-user {
            color: #ffffff;
            font-size: 18px;
        }

        .menu-button {
            background: none;
            border: none;
            color: #00aaff;
            font-size: 24px;
            cursor: pointer;
        }

        /* Content */
        .content {
            margin-left: 260px;
            padding: 20px;
            transition: margin-left 0.3s ease-in-out;
        }

            .content.full-width {
                margin-left: 80px;
            }

        /* Cards */
        .card {
            background: linear-gradient(to right, #000000, #122438);
            color: #ffffff;
            border: none;
            transition: transform 0.3s, box-shadow 0.3s;
            border-radius: 10px;
            padding: 25px;
        }

            .card:hover {
                transform: scale(1.05);
                box-shadow: 0px 4px 12px rgba(0, 170, 255, 0.3);
            }

            .card i {
                font-size: 35px;
                margin-bottom: 10px;
            }

        .text-info {
            color: #00c3ff !important;
        }

        .text-success {
            color: #00ffcc !important;
        }

        .text-warning {
            color: #ffaa00 !important;
        }

    </style>
</head>

<body>
    <!-- Sidebar -->
    <nav class="sidebar d-flex flex-column p-3" id="sidebar">
        <ul class="nav flex-column" style="    margin-top: -11px;">
            <li class="navbar">
                <button class="menu-button" onclick="toggleSidebar()">☰</button>
            </li>
            <li class="nav-item">
                <a class="nav-link " asp-controller="EmployeeDashboard" asp-action="Index">
                    <i class="fas fa-home"></i> <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="EmployeeDashboard" asp-action="MyTest">
                    <i class="fas fa-file-alt"></i> <span>My Tests</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="EmployeeDashboard" asp-action="MyTraining">
                    <i class="fas fa-book-open"></i> <span>My Training</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="EmployeeDashboard" asp-action="AssignedProjects">
                    <i class="fas fa-tasks"></i> <span>My Projects</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="EmployeeDashboard" asp-action="TestResults">
                    <i class="fas fa-chart-bar"></i> <span>My Performance</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" asp-controller="EmployeeDashboard" asp-action="MyFeedback">
                    <i class="fas fa-comment-dots"></i> <span>My Feedback</span>
                </a>
            </li>
            <li class="nav-item">
                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link btn btn-link text-danger">
                        <i class="fas fa-sign-out-alt"></i> <span>Log Out</span>
                    </button>
                </form>
            </li>
        </ul>
    </nav>

  
    <div class="content" id="content">
        <nav class="navbar" style="margin-top: -20px; margin-left: -20px">
            <span class="navbar-brand">Employee Dashboard</span>
            <span class="navbar-user">Welcome, @ViewBag.Username</span>
        </nav>
        <div class="container mt-5">
            <h2 class="text-center text-primary fw-bold mb-4">My Feedback Reports</h2>

            @if (!Model.Any())
            {
                <div class="alert alert-warning text-center fw-bold">
                    No feedback available yet.
                </div>
            }
            else
            {
                @foreach (var report in Model)
                {
                    <div class="card shadow-lg border-0 mb-5 rounded-4">
                        <div class="card-header bg-primary text-white rounded-top-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Feedback Report - @report.CreatedAt.ToShortDateString()</h5>
                            </div>
                        </div>

                        <div class="card-body p-4">

                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <p>
                                        <strong>Pre-Training Marks:</strong>
                                        <span class="badge bg-info text-dark">
                                            @(report.PreTrainingMarks >= 0 ? report.PreTrainingMarks : "Not Available")
                                        </span>
                                    </p>
                                    <p>
                                        <strong>Mid-Training Marks:</strong>
                                        <span class="badge bg-info text-dark">
                                            @(report.MidTrainingMarks >= 0 ? report.MidTrainingMarks : "Not Available")
                                        </span>
                                    </p>
                                </div>
                                <div class="col-md-6">
                                    <p>
                                        <strong>Post-Training Marks:</strong>
                                        <span class="badge bg-info text-dark">
                                            @(report.PostTrainingMarks >= 0 ? report.PostTrainingMarks : "Not Available")
                                        </span>
                                    </p>
                                    <p>
                                        <strong>Project Marks:</strong>
                                        <span class="badge bg-success">
                                            @(report.ProjectMarks >= 0 ? report.ProjectMarks : "Not Available")
                                        </span>
                                    </p>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-bold ">Trainer Feedback</h6>
                                <blockquote class="blockquote p-3 bg-light border-start border-4 border-primary rounded-3">
                                    <p class="mb-0 text-dark">@report.Feedback</p>
                                </blockquote>
                            </div>

                            @{
                                var map = new Dictionary<string, string>
                    {
                    { "Timeliness", "Punctuality & Attendance - Timeliness in attending training sessions" },
                    { "Break Schedule", "Punctuality & Attendance - Adherence to break schedules" },
                    { "Attendance", "Punctuality & Attendance - Consistency in attendance" },
                    { "Interaction", "Participation & Engagement - Level of interaction during training" },
                    { "Asking Questions", "Participation & Engagement - Willingness to ask questions" },
                    { "Group Work", "Participation & Engagement - Contribution to group discussions" },
                    { "Assessment Performance", "Learning Progress - Performance in assessments" },
                    { "Application", "Learning Progress - Ability to apply learned concepts" },
                    { "Improvement", "Learning Progress - Improvement over time" },
                    { "Analysis", "Problem-Solving - Ability to analyze scenarios" },
                    { "Troubleshooting", "Problem-Solving - Approach to troubleshooting issues" },
                    { "Creativity", "Problem-Solving - Creativity in problem-solving" },
                    { "Clarity", "Communication Skills - Clarity in expressing thoughts" },
                    { "Confidence", "Communication Skills - Confidence in presenting information" },
                    { "Listening", "Communication Skills - Active listening skills" },
                    { "Teamwork", "Teamwork - Ability to work effectively in a team" },
                    { "Support", "Teamwork - Willingness to support peers" },
                    { "Adaptability", "Teamwork - Adaptability to different team roles" },
                    { "Feedback Acceptance", "Adaptability - Readiness to accept feedback" },
                    { "Learning", "Adaptability - Willingness to learn new concepts" },
                    { "Training Styles", "Adaptability - Ability to adjust to training styles" },
                    { "Hands-on", "Practical Application - Hands-on implementation of training" },
                    { "Task Quality", "Practical Application - Quality and accuracy of task completion" },
                    { "Efficiency", "Practical Application - Efficiency in real-world scenarios" },
                    { "Respect", "Professionalism - Respect for trainers and peers" },
                    { "Discipline", "Professionalism - Discipline in following guidelines" },
                    { "Accountability", "Professionalism - Accountability for assigned tasks" },
                    { "Beyond Basics", "Self-Motivation - Willingness to go beyond basic requirements" },
                    { "Proactive", "Self-Motivation - Proactive approach to learning" },
                    { "Additional Resources", "Self-Motivation - Seeking additional learning resources" }
                    };
                            }

                            <div class="mt-4">
                                <h6 class="fw-bold ">Feedback Criteria</h6>
                                @if (!string.IsNullOrWhiteSpace(report.FeedbackCriteria))
                                {
                                    <div class="row">
                                        @{
                                            int counter = 1;
                                        }

                                        @foreach (var criteria in report.FeedbackCriteria.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            var trimmed = criteria.Trim();
                                            if (map.ContainsKey(trimmed))
                                            {
                                                var fullText = map[trimmed];
                                                var parts = fullText.Split(" - ", 2);
                                                var category = parts[0];
                                                var description = parts.Length > 1 ? parts[1] : "";

                                                <div class="col-md-6 mb-3">
                                                    <div class="p-3 bg-light border rounded-3 h-100 shadow-sm">
                                                        <strong class="text-primary">@counter. @category</strong>
                                                        <div class="text-muted ms-2">- @description</div>
                                                    </div>
                                                </div>

                                                counter++;
                                            }
                                            else
                                            {
                                                <div class="col-md-6 mb-3">
                                                    <div class="p-3 bg-light border rounded-3 h-100 shadow-sm">
                                                        <strong class="text-danger">@counter. Unknown</strong>
                                                        <div class="text-muted ms-2">- @trimmed</div>
                                                    </div>
                                                </div>

                                                counter++;
                                            }
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted">No Feedback Criteria Available</div>
                                }
                            </div>

                        </div>
                    </div>
                }
            }
        </div>
    </div>
  </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById("sidebar");
            const content = document.getElementById("content");
            sidebar.classList.toggle("collapsed");
            content.classList.toggle("full-width");
        }
    </script>
</body>









