        function sendNotification() {
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const testType = document.getElementById("testTypeSelect").value;
    const testDate = document.getElementById("testDate").value;
    const testTime = document.getElementById("testTime").value;

    // Validate inputs
    if (!testType || !testDate || !testTime) {
        Swal.fire({
            icon: "warning",
            title: "Missing Information",
            text: "Please select a test type, date, and time before sending the notification.",
        });
        return;
    }

    // Confirm action
    Swal.fire({
        title: "Send Notification?",
        text: `Are you sure you want to notify employees about the ${testType} test on ${testDate} at ${testTime}?`,
        icon: "question",
        showCancelButton: true,
        confirmButtonText: "Yes, send it!",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#28a745",
        cancelButtonColor: "#d33"
    }).then((result) => {
        if (result.isConfirmed) {
            // Send request
            fetch('/AdminDashboard/SendNotification', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ testType, date: testDate, time: testTime })
            })
            .then(response => response.json().then(data => ({ status: response.ok, body: data })))
            .then(({ status, body }) => {
                if (status) {
                    Swal.fire({
                        icon: "success",
                        title: "Notification Sent",
                        text: body.message || "Employees have been notified successfully!",
                    });
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Notification Failed",
                        text: body.error || "An error occurred while sending the notification.",
                    });
                }
            })
            .catch(error => {
                console.error("Fetch Error:", error);
                Swal.fire({
                    icon: "error",
                    title: "Network Error",
                    text: "There was an issue connecting to the server. Please try again later.",
                });
            });
        }
    });
}

    </script>
    
</body>









