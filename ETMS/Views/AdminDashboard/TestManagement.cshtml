<script>
    function saveModeStatus(testType, mode) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        fetch('/AdminDashboard/UpdateTestMode', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ testType, mode })
        })
        .then(response => response.json())
        .then(data => alert(data.message))
        .catch(error => alert(`Error: ${error.message}`));
    }


    function sendNotification() {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const testType = document.getElementById("testTypeSelect").value;
        const testDate = document.getElementById("testDate").value;
        const testTime = document.getElementById("testTime").value;

        if (!testType || !testDate || !testTime) {
            alert("Please select a test type, date, and time.");
            return;
        }

        fetch('/AdminDashboard/SendNotification', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ testType, date: testDate, time: testTime })
        })
            .then(response => response.json())
            .then(data => alert(data.message))
            .catch(error => alert(`Error: ${error.message}`));
    }
</script>
