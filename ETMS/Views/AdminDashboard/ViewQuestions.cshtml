@model IEnumerable<ETMS.Models.Question>

@{
    ViewData["Title"] = "Questions";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Questions for @ViewBag.TestType</h4>
            <a asp-action="CreateQuestion" asp-route-testType="@ViewBag.TestType" class="btn btn-light btn-sm">
                <i class="bi bi-plus-circle"></i> Add Question
            </a>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped text-center">
                <thead class="table-dark text-white">
                    <tr>
                        <th style="width: 10%;">No</th>
                        <th style="width: 50%;">Question</th>
                        <th style="width: 15%;">Correct Answer</th>
                        <th style="width: 25%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int counter = 1;
                    }
                    @foreach (var question in Model)
                    {
                        <tr>
                            <td>@counter</td>
                            <td class="text-start">@question.QuestionText</td>
                            <td>@question.CorrectAnswer</td>
                            <td>
                                <a asp-action="EditQuestion" asp-route-id="@question.Id" class="btn btn-warning btn-sm">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <button class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal-@question.Id">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </td>
                        </tr>

                        <!-- Delete Confirmation Modal -->
                        <div class="modal fade" id="deleteModal-@question.Id" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title text-danger">Confirm Delete</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Are you sure you want to delete this question?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <a asp-action="DeleteQuestion" asp-route-id="@question.Id" class="btn btn-danger">Yes, Delete</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        counter++;
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-end mt-3">
                <a asp-action="TestManagement" class="btn btn-dark">
                    <i class="bi bi-arrow-left"></i> Back to Test Management
                </a>
            </div>
        </div>
    </div>
</div>



