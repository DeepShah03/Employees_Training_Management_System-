 @model IEnumerable<dynamic>

<div class="container mt-4">
    <h2 class="text-primary fw-bold mb-4">📂 Project Submissions</h2>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-primary">
                            <tr>
                                <th>Employee</th>
                                <th>Project Name</th>
                                <th>Deadline</th>
                                <th>Submission Date</th>
                                <th>File</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var submission in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@submission.EmployeeName</td>
                                    <td>@submission.ProjectName</td>
                                    <td class="text-danger fw-semibold">@submission.Deadline.ToString("MMM dd, yyyy")</td>
                                    <td class="text-success">@submission.SubmissionDate.ToString("MMM dd, yyyy | HH:mm")</td>
                                    <td>
                                        <a href="@Url.Content("~/UploadedProjects/" + submission.FilePath)" class="btn btn-sm btn-outline-primary" download>
                                            <i class="bi bi-download"></i> Download
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted text-center fs-5">🚀 No project submissions available yet.</p>
            }
        </div>
    </div>

    <!-- Back Button -->
    <div class="mt-3">
        <a href="@Url.Action("Index", "TrainerDashboard")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>
