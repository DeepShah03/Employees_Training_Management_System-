@model List<ETMS.Models.Project>

@{
    ViewData["Title"] = "Manage Project";
}
<head>
    <title>@ViewData["Title"] - Trainer Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            color: #ffffff;
            /* background: linear-gradient(to right, #121212, #1e1e1e);  */
            /*             background: linear-gradient(to right, #000000, #150c0c);
                 */
        }

        .sidebar {
            height: 100vh;
            width: 270px;
            position: fixed;
            background: linear-gradient(to bottom, #1e1e1e, #252525); /* Dark sidebar gradient */
            /* background: linear-gradient(to bottom, #212f3f, #3b0909); */
            padding-top: 20px;
            transition: all 0.3s ease-in-out;
            overflow: hidden;
        }

            .sidebar.collapsed {
                width: 101px;
            }

            .sidebar .nav-link {
                color: #ffffff;
                font-size: 16px;
                padding: 15px;
                display: flex;
                align-items: center;
                transition: background 0.3s, padding-left 0.3s;
                white-space: nowrap;
                border-radius: 5px;
            }

                .sidebar .nav-link i {
                    min-width: 52px;
                    text-align: center;
                    color: #aaaaaa; /* Soft gray icons */
                    transition: color 0.3s;
                }

                .sidebar .nav-link:hover {
                    background-color: #333;
                }

                .sidebar .nav-link.active {
                    background-color: #444;
                    font-weight: bold;
                    border-left: 4px solid blue; /* Highlight effect */
                }

                    .sidebar .nav-link.active i {
                        color: blue; /* Active icon color */
                    }

            .sidebar.collapsed .nav-link {
                justify-content: center;
                padding-left: 0;
            }

                .sidebar.collapsed .nav-link span {
                    display: none;
                }

        .navbar {
            background: linear-gradient(to right, #1e1e1e, #252525); /* Dark gradient navbar */
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 10px rgba(255, 255, 255, 0.1); /* Subtle shadow */
        }

        .navbar-brand, .navbar-user {
            color: #ffffff;
            font-weight: 500;
        }

        .menu-button {
            background: none;
            border: none;
            color: #ffffff;
            font-size: 24px;
            cursor: pointer;
        }

        .content {
            margin-left: 250px;
            padding: 20px;
            transition: margin-left 0.3s ease-in-out;
        }

            .content.full-width {
                margin-left: 80px;
            }

        .card {
            background: linear-gradient(to right, #222, #2a2a2a); /* Dark card gradient */
            color: #ffffff;
            border: none;
            border-radius: 10px;
            transition: transform 0.3s, box-shadow 0.3s;
        }

            .card:hover {
                transform: scale(1.05);
                box-shadow: 0px 4px 15px rgba(255, 0, 0, 0.3); /* Soft glow effect */
            }
    </style>
</head>

<body>
    <nav class="sidebar d-flex flex-column p-3" id="sidebar">
        <ul class="nav flex-column" style="    margin-top: -11px;">
            <li class="navbar">
                <button class="menu-button" onclick="toggleSidebar()">☰</button>
            </li>
            <li class="nav-item">
                <a class="nav-link " asp-controller="TrainerDashboard" asp-action="Index">
                    <i class="fas fa-home"></i> <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link " asp-controller="TrainerDashboard" asp-action="ManageModules">
                    <i class="fa-sharp fa-solid fa-people-roof"></i>
                    <span>Manage Modules</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="TrainerDashboard" asp-action="ManageTraining">
                    <i class="fa-sharp fa-solid fa-folder-open"></i> <span>Manage Training</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link  active" asp-controller="TrainerDashboard" asp-action="ManageProjects">
                    <i class="fa-solid fa-water"></i>
                    <span>Manage Projects</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="TrainerDashboard" asp-action="ManagePro">
                    <i class="fa-solid fa-soap"></i>
                    <span>Assign Projects</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="EmployeeProgress" asp-action="Index">
                    <i class="fas fa-chart-line"></i> <span>Employee Progress</span>
                </a>
            </li>
            <li class="nav-item">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link btn btn-link text-danger">
                        <i class="fas fa-sign-out-alt"></i> <span>Log Out</span>
                    </button>
                </form>
            </li>
        </ul>
    </nav>

    <div class="content" id="content">
        <nav class="navbar" style="margin-top:-19px;">
            <span class="navbar-brand">Trainer Dashboard</span>
            <span class="navbar-user">Welcome,@ViewBag.TrainerName</span>
        </nav>
        <div class="container mt-4">
            <!-- Manage Projects Section -->
            <h2 class="mb-3 text-primary fw-bold">📁 Manage Projects</h2>

            <div class="card p-4 mb-4 shadow-sm border-0">
                <h4 class="mb-3 text-white fw-bold">Create a New Project</h4>
                <form method="post" asp-action="CreateProject">
                    <div class="mb-3">
                        <label for="projectName" class="form-label fw-semibold">Project Name</label>
                        <input type="text" id="projectName" name="projectName" class="form-control" placeholder="Enter Project Name" required />
                    </div>
                    <div class="mb-3">
                        <label for="projectDescription" class="form-label fw-semibold">Project Description</label>
                        <textarea id="projectDescription" name="projectDescription" class="form-control" rows="3" placeholder="Enter Project Description" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="deadline" class="form-label fw-semibold">Deadline</label>
                        <input type="date" id="deadline" name="deadline" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-folder-plus"></i> Create Project
                    </button>
                </form>

                <!-- Navigation to Project Submission Page -->
                <div class="mt-3">
                    <a href="@Url.Action( "ProjectSubmissions","TrainerDashboard")" class="btn btn-outline-info px-4">
                        <i class="bi bi-upload"></i> View Project Submissions
                    </a>
                </div>
            </div>

            <!-- Project List Section -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">📁 List of Projects</h5>
                </div>
                <ul class="list-group list-group-flush">
                    @if (Model.Any())
                    {
                        @foreach (var project in Model)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="fw-bold mb-1">📁 @project.ProjectName</h6>
                                    <p class="mb-1 text-muted">@project.Description</p>
                                    <p class="text-danger fw-semibold mb-0">Deadline: @project.Deadline.ToShortDateString()</p>
                                </div>
                                <form method="post" asp-action="DeleteProject"
                                      onsubmit="return confirm('Are you sure you want to delete this project?');">
                                    <input type="hidden" name="projectId" value="@project.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger px-3">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-center text-muted">No projects available.</li>
                    }
                </ul>
            </div>
        </div>


        @* <div class="container mt-4">
            <!-- Manage Projects Section -->
            <h2 class="mb-3 text-primary fw-bold">📁 Manage Projects</h2>
            <div class="card p-3 mb-4 shadow-sm">
                <h2 class="mb-3 text-white fw-bold">Create Project</h2>
                <form method="post" asp-action="CreateProject">
                    <div class="mb-3">
                        <label for="projectName" class="form-label">Project Name</label>
                        <input type="text" id="projectName" name="projectName" class="form-control" placeholder="Enter Project Name" required />
                    </div>
                    <div class="mb-3">
                        <label for="projectDescription" class="form-label">Project Description</label>
                        <textarea id="projectDescription" name="projectDescription" class="form-control" placeholder="Enter Project Description" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="deadline" class="form-label">Deadline</label>
                        <input type="date" id="deadline" name="deadline" class="form-control" required />
                    </div>
