                    </button>
                </form>

                <!-- Button to go to Project Submission Page -->
                <div class="mb-4">
                    <a href="@Url.Action( "ProjectSubmissions","TrainerDashboard")" class="btn btn-info">
                        <i class="bi bi-upload"></i> Go to Project Submission Page
                    </a>
                </div>
            </div>

         
            <!-- Projects List -->
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">📁 List Projects</h5>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var project in Model)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold">📁 @project.ProjectName</span>
                                <p class="mb-0"><small>@project.Description</small></p>
                                <p class="text-muted mb-0"><small>Deadline: @project.Deadline.ToShortDateString()</small></p>
                            </div>
