@using ETMS.Models.ViewModels
@model ModuleMaterialsViewModel
@{
    ViewData["Title"] = "Trainer Dashboard";
}
<head>
    <title>@ViewData["Title"] - Trainer Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            color: #ffffff;
            /* background: linear-gradient(to right, #121212, #1e1e1e);  */
            /*             background: linear-gradient(to right, #000000, #150c0c);
         */
        }

        .sidebar {
            height: 100vh;
            width: 270px;
            position: fixed;
            background: linear-gradient(to bottom, #1e1e1e, #252525); /* Dark sidebar gradient */
            /* background: linear-gradient(to bottom, #212f3f, #3b0909); */
            padding-top: 20px;
            transition: all 0.3s ease-in-out;
            overflow: hidden;
        }

            .sidebar.collapsed {
                width: 101px;
            }

            .sidebar .nav-link {
                color: #ffffff;
                font-size: 16px;
                padding: 15px;
                display: flex;
                align-items: center;
                transition: background 0.3s, padding-left 0.3s;
                white-space: nowrap;
                border-radius: 5px;
            }

                .sidebar .nav-link i {
                    min-width: 52px;
                    text-align: center;
                    color: #aaaaaa; /* Soft gray icons */
                    transition: color 0.3s;
                }

                .sidebar .nav-link:hover {
                    background-color: #333;
                }

                .sidebar .nav-link.active {
                    background-color: #444;
                    font-weight: bold;
                    border-left: 4px solid blue; /* Highlight effect */
                }

                    .sidebar .nav-link.active i {
                        color: blue; /* Active icon color */
                    }

            .sidebar.collapsed .nav-link {
                justify-content: center;
                padding-left: 0;
            }

                .sidebar.collapsed .nav-link span {
                    display: none;
                }

        .navbar {
            background: linear-gradient(to right, #1e1e1e, #252525); /* Dark gradient navbar */
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 10px rgba(255, 255, 255, 0.1); /* Subtle shadow */
        }

        .navbar-brand, .navbar-user {
            color: #ffffff;
            font-weight: 500;
        }

        .menu-button {
            background: none;
            border: none;
            color: #ffffff;
            font-size: 24px;
            cursor: pointer;
        }

        .content {
            margin-left: 250px;
            padding: 20px;
            transition: margin-left 0.3s ease-in-out;
        }

            .content.full-width {
                margin-left: 80px;
            }

        .card {
            background: linear-gradient(to right, #222, #2a2a2a); /* Dark card gradient */
            color: #ffffff;
            border: none;
            border-radius: 10px;
            transition: transform 0.3s, box-shadow 0.3s;
        }

            .card:hover {
                transform: scale(1.05);
                box-shadow: 0px 4px 15px rgba(255, 0, 0, 0.3); /* Soft glow effect */
            }
    </style>
</head>

<body>
    <nav class="sidebar d-flex flex-column p-3" id="sidebar">
        <ul class="nav flex-column" style="    margin-top: -11px;">
            <li class="navbar">
                <button class="menu-button" onclick="toggleSidebar()">☰</button>
            </li>
            <li class="nav-item">
                <a class="nav-link " asp-controller="TrainerDashboard" asp-action="Index">
                    <i class="fas fa-home"></i> <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" asp-controller="TrainerDashboard" asp-action="ManageModules">
                    <i class="fa-sharp fa-solid fa-people-roof"></i>
                    <span>Manage Modules</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="TrainerDashboard" asp-action="ManageTraining">
                    <i class="fa-sharp fa-solid fa-folder-open"></i> <span>Manage Training</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link  " asp-controller="TrainerDashboard" asp-action="ManageProjects">
                    <i class="fa-solid fa-water"></i>
                    <span>Manage Projects</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="TrainerDashboard" asp-action="ManagePro">
                    <i class="fa-solid fa-soap"></i>
                    <span>Assign Projects</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="EmployeeProgress" asp-action="Index">
                    <i class="fas fa-chart-line"></i> <span>Employee Progress</span>
                </a>
            </li>
            <li class="nav-item">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link btn btn-link text-danger">
                        <i class="fas fa-sign-out-alt"></i> <span>Log Out</span>
                    </button>
                </form>
            </li>
        </ul>
    </nav>

    <div class="content" id="content">
        <nav class="navbar" style="margin-top:-19px;">
            <span class="navbar-brand">Trainer Dashboard</span>
            <span class="navbar-user">Welcome,@ViewBag.TrainerName</span>
        </nav>

        <div class="container mt-4">
            
            <!-- Page Title -->
            <h2 class="text-center text-primary fw-bold">📂 Manage Materials for @Model.ModuleName</h2>
            <!-- Back Button -->
            <a asp-action="ManageModules" class="btn btn-outline-secondary mb-3">
                <i class="fas fa-arrow-left"></i> Back
            </a>

            <!-- Upload Section -->
            <div class="card p-3 my-4 shadow-sm">
                <h5 class="mb-3"><i class="fas fa-upload"></i> Upload Material</h5>
                <form method="post" asp-action="UploadMaterial" enctype="multipart/form-data">
                    <input type="hidden" name="moduleId" value="@Model.ModuleId" />
                    <div class="input-group">
                        <input type="file" class="form-control" name="file" required />
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-cloud-upload-alt"></i> Upload
                        </button>
                    </div>
                </form>
            </div>

            <!-- Video Materials Section -->
            <h3 class="text-primary mt-4"><i class="fas fa-video"></i> Videos</h3>
            @if (Model.LearningMaterials.Any(m => m.FileType == "Video"))
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-dark text-center">
                            <tr>
                                <th>Preview</th>
                                <th>Title</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var material in Model.LearningMaterials.Where(m => m.FileType == "Video"))
                            {
                                <tr class="text-center">
                                    <td>
                                        <video width="200" height="120" controls class="rounded shadow">
                                            <source src="@material.FilePath" type="video/mp4">
                                            Your browser does not support the video tag.
                                        </video>
                                    </td>
                                    <td>@System.IO.Path.GetFileNameWithoutExtension(material.FileName)</td>
                                    <td>
                                        <form method="post" asp-action="DeleteMaterial">
                                            <input type="hidden" name="id" value="@material.Id" />
                                            <input type="hidden" name="moduleId" value="@Model.ModuleId" />
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="fas fa-trash-alt"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No videos available.</p>
            }

            <!-- PDF Materials Section -->
            <h3 class="text-primary mt-4"><i class="fas fa-file-pdf"></i> PDFs</h3>
            @if (Model.LearningMaterials.Any(m => m.FileType == "PDF"))
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-dark text-center">
                            <tr>
                                <th>File</th>
                                <th>Title</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var material in Model.LearningMaterials.Where(m => m.FileType == "PDF"))
                            {
                                <tr class="text-center">
                                    <td>
                                        <a href="@material.FilePath" target="_blank" class="btn btn-primary">
                                            <i class="fas fa-file-pdf"></i> Open PDF
                                        </a>
                                    </td>
                                    <td>@System.IO.Path.GetFileNameWithoutExtension(material.FileName)</td>
                                    <td>
                                        <form method="post" asp-action="DeleteMaterial">
                                            <input type="hidden" name="id" value="@material.Id" />
                                            <input type="hidden" name="moduleId" value="@Model.ModuleId" />
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="fas fa-trash-alt"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No PDFs available.</p>
            }
        </div>

        <!-- Bootstrap and FontAwesome Icons -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    </div>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById("sidebar");
            const content = document.getElementById("content");
            sidebar.classList.toggle("collapsed");
            content.classList.toggle("full-width");
        }
    </script>
</body>


















