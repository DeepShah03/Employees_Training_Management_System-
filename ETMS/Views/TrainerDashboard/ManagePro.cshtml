
@{
    ViewData["Title"] = "Assign Project";
}
<head>
    <title>@ViewData["Title"] - Trainer Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            color: #ffffff;
            /* background: linear-gradient(to right, #121212, #1e1e1e);  */
            /*             background: linear-gradient(to right, #000000, #150c0c);
                         */
        }

        .sidebar {
            height: 100vh;
            width: 270px;
            position: fixed;
            background: linear-gradient(to bottom, #1e1e1e, #252525); /* Dark sidebar gradient */
            /* background: linear-gradient(to bottom, #212f3f, #3b0909); */
            padding-top: 20px;
            transition: all 0.3s ease-in-out;
            overflow: hidden;
        }

            .sidebar.collapsed {
                width: 101px;
            }

            .sidebar .nav-link {
                color: #ffffff;
                font-size: 16px;
                padding: 15px;
                display: flex;
                align-items: center;
                transition: background 0.3s, padding-left 0.3s;
                white-space: nowrap;
                border-radius: 5px;
            }

                .sidebar .nav-link i {
                    min-width: 52px;
                    text-align: center;
                    color: #aaaaaa; /* Soft gray icons */
                    transition: color 0.3s;
                }

                .sidebar .nav-link:hover {
                    background-color: #333;
                }

                .sidebar .nav-link.active {
                    background-color: #444;
                    font-weight: bold;
                    border-left: 4px solid blue; /* Highlight effect */
                }

                    .sidebar .nav-link.active i {
                        color: blue; /* Active icon color */
                    }

            .sidebar.collapsed .nav-link {
                justify-content: center;
                padding-left: 0;
            }

                .sidebar.collapsed .nav-link span {
                    display: none;
                }

        .navbar {
            background: linear-gradient(to right, #1e1e1e, #252525); /* Dark gradient navbar */
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 10px rgba(255, 255, 255, 0.1); /* Subtle shadow */
        }

        .navbar-brand, .navbar-user {
            color: #ffffff;
            font-weight: 500;
        }

        .menu-button {
            background: none;
            border: none;
            color: #ffffff;
            font-size: 24px;
            cursor: pointer;
        }

        .content {
            margin-left: 250px;
            padding: 20px;
            transition: margin-left 0.3s ease-in-out;
        }

            .content.full-width {
                margin-left: 80px;
            }

        .card {
            background: linear-gradient(to right, #222, #2a2a2a); /* Dark card gradient */
            color: #ffffff;
            border: none;
            border-radius: 10px;
            transition: transform 0.3s, box-shadow 0.3s;
        }

            .card:hover {
                transform: scale(1.05);
                box-shadow: 0px 4px 15px rgba(255, 0, 0, 0.3); /* Soft glow effect */
            }
    </style>
</head>

<body>
    <nav class="sidebar d-flex flex-column p-3" id="sidebar">
        <ul class="nav flex-column" style="    margin-top: -11px;">
            <li class="navbar">
                <button class="menu-button" onclick="toggleSidebar()">☰</button>
            </li>
            <li class="nav-item">
                <a class="nav-link " asp-controller="TrainerDashboard" asp-action="Index">
                    <i class="fas fa-home"></i> <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link " asp-controller="TrainerDashboard" asp-action="ManageModules">
                    <i class="fa-sharp fa-solid fa-people-roof"></i>
                    <span>Manage Modules</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="TrainerDashboard" asp-action="ManageTraining">
                    <i class="fa-sharp fa-solid fa-folder-open"></i> <span>Manage Training</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link  " asp-controller="TrainerDashboard" asp-action="ManageProjects">
                    <i class="fa-solid fa-water"></i>
                    <span>Manage Projects</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" asp-controller="TrainerDashboard" asp-action="ManagePro">
                    <i class="fa-solid fa-soap"></i>
                    <span>Assign Projects</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="EmployeeProgress" asp-action="Index">
                    <i class="fas fa-chart-line"></i> <span>Employee Progress</span>
                </a>
            </li>
            <li class="nav-item">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link btn btn-link text-danger">
                        <i class="fas fa-sign-out-alt"></i> <span>Log Out</span>
                    </button>
                </form>
            </li>
        </ul>
    </nav>

    <div class="content" id="content">
        <nav class="navbar" style="margin-top:-19px;">
            <span class="navbar-brand">Trainer Dashboard</span>
            <span class="navbar-user">Welcome,@ViewBag.TrainerName</span>
        </nav>
        <div class="container mt-4">
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4" style="margin-top: 25px; margin-right: 140px;">
                <h2 class="mb-4" style="color:black;">Assign Projects to Employees</h2>

                <!-- Assignment Form -->
                <form method="post" asp-action="AssignProject">
                    <div class="card p-3 mb-4">
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="employeeId" class="form-label">Employee</label>
                                <select name="employeeId" id="employeeId" class="form-select" required>
                                    <option value="">-- Select Employee --</option>
                                    @foreach (var employee in Model)
                                    {
                                        <option value="@employee.Id">@employee.UserName</option>
                                    }
                                </select>
                            </div>

                            <!-- Project Dropdown -->
                            <div class="col-md-4">
                                <label for="projectId" class="form-label">Project</label>
                                <select name="projectId" id="projectId" class="form-select" required>
                                    <option value="">-- Select Project --</option>
                                    @foreach (var project in ViewBag.Projects)
                                    {
                                        <option value="@project.Id">@project.ProjectName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Assign</label><br>
                                <button type="submit" class="btn btn-primary" style="width: -webkit-fill-available;">
                                    Assign Project
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                <!-- Display Assigned Projects -->
                <div class="card p-3">
                    <h4 class="mb-3">Assigned Projects</h4>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th colspan="4">Assigned Projects</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var employee in Model)
                            {
                                <tr>
                                    <td>@employee.UserName</td>
                                    @{
                                        var assignedProjectsList = employee.AssignedProjects ?? new List<EmployeeProject>();


                                    }
                                    @for (int i = 0; i < 4; i++)
                                    {
                                        <td>
                                            @if (i < assignedProjectsList.Count)
                                            {
                                                <form method="post" asp-action="UnassignProject" class="d-inline">
                                                    <input type="hidden" name="employeeId" value="@employee.Id" />
                                                    <input type="hidden" name="projectId" value="@assignedProjectsList[i].Project.Id" />
                                                    @assignedProjectsList[i].Project.ProjectName
                                                    <button type="submit" class="btn btn-danger btn-sm">Unassign</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted">---</span>
                                            }
                                        </td>
                                    }


                                    <td>
                                        @if (employee.AssignedProjects != null && employee.AssignedProjects.Count > 0)
                                        {
                                            <form method="post" asp-action="UnassignAllProjects" class="d-inline">
                                                <input type="hidden" name="employeeId" value="@employee.Id" />
                                                <button type="submit" class="btn btn-warning btn-sm">Unassign All</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </main>
        </div>
       @*  <div class="container mt-4">
            <h3>Assigned Projects with Submissions</h3>
            <table class="table table-bordered table-hover">
                <thead class="thead-dark">
                    <tr>
                        <th>Project Name</th>
                        <th>Employee Name</th>
                        <th>Submitted File</th>
                        <th>Submission Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Project.ProjectName</td>

                            <!-- Display the employees who submitted the project -->
