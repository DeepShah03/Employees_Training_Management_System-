@model ETMS.Models.ApplicationUser
@{
    ViewData["Title"] = "Assign Trainer";
}
<head>
    <title>@ViewData["Title"] - Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>


        .sidebar {
            height: 100vh;
            width: 270px;
            position: fixed;
            background-color: #1e1e1e;
            padding-top: 20px;
            transition: all 0.3s ease-in-out;
            overflow: hidden;
        }

            .sidebar.collapsed {
                width: 101px;
            }

            .sidebar .nav-link {
                color: #ffffff;
                font-size: 16px;
                padding: 15px;
                display: flex;
                align-items: center;
                transition: background 0.3s, padding-left 0.3s;
                white-space: nowrap;
            }

                .sidebar .nav-link i {
                    min-width: 52px;
                    text-align: center;
                    color: #ffffff;
                    transition: color 0.3s;
                }

                .sidebar .nav-link.active {
                    background-color: #333;
                    font-weight: bold;
                }

                    .sidebar .nav-link.active i {
                        color: blue; /* Active icon color */
                    }

            .sidebar.collapsed .nav-link {
                justify-content: center;
                padding-left: 0;
            }

                .sidebar.collapsed .nav-link span {
                    display: none;
                }

        .navbar {
            background-color: #1e1e1e;
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .navbar-brand, .navbar-user {
            color: #ffffff;
        }

        .menu-button {
            background: none;
            border: none;
            color: #ffffff;
            font-size: 24px;
            cursor: pointer;
        }

        .content {
            margin-left: 250px;
            padding: 20px;
            transition: margin-left 0.3s ease-in-out;
        }

            .content.full-width {
                margin-left: 80px;
            }

        .card {
            background-color: #222;
            color: #ffffff;
            border: none;
            transition: transform 0.3s;
        }

            .card:hover {
                transform: scale(1.05);
            }
    </style>

</head>
<body>
    <nav class="sidebar d-flex flex-column p-3" id="sidebar">

        <ul class="nav flex-column" style="    margin-top: -11px;">
            <li class="navbar">
                <button class="menu-button" onclick="toggleSidebar()">☰</button>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["Title"] == "Admin Dashboard" ? "active" : "")" asp-controller="AdminDashboard" asp-action="Index">
                    <i class="fas fa-tachometer-alt"></i> <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["Title"] == "User Management" ? "active" : "")" asp-controller="UserManagement" asp-action="Index">
                    <i class="fas fa-users"></i> <span>User Management</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["Title"] == "Test Management" ? "active" : "")" asp-controller="AdminDashboard" asp-action="TestManagement">
                    <i class="fas fa-tasks"></i> <span>Test Management</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["Title"] == "Assign Trainer" ? "active" : "")" asp-controller="AssignTrainer" asp-action="Index">
                    <i class="fas fa-chalkboard-teacher"></i> <span>Assign Trainer</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewData["Title"] == "Reports & Analytics" ? "active" : "")" asp-controller="AdminDashboard" asp-action="Reports">
                    <i class="fas fa-chart-line"></i> <span>Reports & Analytics</span>
                </a>
            </li>
            <li class="nav-item">
                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link btn btn-link text-danger">
                        <i class="fas fa-sign-out-alt"></i> <span>Log Out</span>
                    </button>
                </form>
            </li>
        </ul>
    </nav>

    <div class="content" id="content">
        <nav class="navbar" style="margin-top: -21px;">
            @* <button class="menu-button" onclick="toggleSidebar()">☰</button> *@
            <span class="navbar-brand">Admin Dashboard</span>
            <span class="navbar-user">Welcome, @ViewBag.AdminName</span>
        </nav>
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4" style="margin-top: 25px;margin-right: 140px;">
            <h2 class="mb-4">Assign Employees to Trainers</h2>

            <!-- Assignment Form -->
            <form method="post" asp-action="Assign" onsubmit="return validateSelection();">
                <div class="card p-3 mb-4">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="trainerId" class="form-label">Trainer</label>
                            <select name="trainerId" id="trainerId" class="form-select" required>
                                <option value="">-- Select Trainer --</option>
                                @foreach (var trainer in (IEnumerable<ETMS.Models.ApplicationUser>)ViewBag.Trainers)
                                {
                                    <option value="@trainer.Id">@trainer.UserName</option>
                                }
                            </select>
                        </div>

                        <!-- Employee Dropdowns (4 slots) -->
                        @for (int i = 0; i < 4; i++)
                        {
                            <div class="col-md-2">
                                <label class="form-label">Employee @* @i+1 *@</label>
                                <select name="employeeIds" class="form-select employee-dropdown">
                                    <option value="">-- Select Employee --</option>
                                    @foreach (var employee in (IEnumerable<ETMS.Models.ApplicationUser>)ViewBag.Employees)
                                    {
                                        <option value="@employee.Id">@employee.UserName</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                    <button type="submit" class="btn btn-primary">Assign</button>
                </div>
            </form>

            <!-- Display Assigned Employees -->
            <div class="card p-3">
                <h4 class="mb-3">Assigned Employees</h4>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Trainer</th>
                            <th colspan="4">Assigned Employees</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trainer in (IEnumerable<ETMS.Models.ApplicationUser>)ViewBag.Trainers)
                        {
                            var assignedEmployees = ((IEnumerable<ETMS.Models.ApplicationUser>)ViewBag.Employees)
                            .Where(e => e.AssignedTrainerId == trainer.Id).ToList();
                            <tr>
                                <td>@trainer.UserName</td>
                                @for (int i = 0; i < 4; i++)
                                {
                                    <td>
                                        @if (i < assignedEmployees.Count)
                                        {
                                            <form method="post" asp-action="Unassign" class="d-inline">
                                                <input type="hidden" name="employeeId" value="@assignedEmployees[i].Id" />
                                                @assignedEmployees[i].UserName
                                                <button type="submit" class="btn btn-danger btn-sm">Unassign</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                    </td>
                                }
                                <td>
                                    @if (assignedEmployees.Any())
                                    {
                                        <form method="post" asp-action="UnassignAll" class="d-inline">
                                            <input type="hidden" name="trainerId" value="@trainer.Id" />
                                            <button type="submit" class="btn btn-warning btn-sm">Unassign All</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>

   </div>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById("sidebar");
            const content = document.getElementById("content");
            sidebar.classList.toggle("collapsed");
            content.classList.toggle("full-width");
        }
        function validateSelection() {
            const employeeDropdowns = document.querySelectorAll('.employee-dropdown');
            const isAnyEmployeeSelected = Array.from(employeeDropdowns).some(dropdown => dropdown.value !== "");

            if (!isAnyEmployeeSelected) {
                alert('Please select at least one employee to assign.');
                return false; // Prevent form submission
            }

            const selectedValues = Array.from(employeeDropdowns)
                .map(dropdown => dropdown.value)
                .filter(value => value !== "");

            const uniqueValues = new Set(selectedValues);

            if (selectedValues.length !== uniqueValues.size) {
                alert('Duplicate employees selected. Please select unique employees.');
                return false; // Prevent form submission
            }

            return true; // Allow form submission
        }


    </script>

</body>

